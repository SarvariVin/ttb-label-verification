# Copy to .env and fill in. Never commit .env. No credential has a default value.

# --- Database (docker compose + app) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/labelverification
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Bootstrap accounts on an empty database: 1 specialist + 2 test applicants ---
# Leave APP_SEED_PASSWORD empty to have a random one generated and logged once.
APP_SEED=true
APP_SEED_PASSWORD=
APP_SEED_RESET_PASSWORD=false
APP_SEED_SPECIALIST_EMAIL=specialist@example.gov
APP_SEED_APPLICANT_EMAIL=applicant@example.com
APP_SEED_APPLICANT_COMPANY=Sample Distilling Co.
APP_SEED_APPLICANT2_EMAIL=applicant.two@example.com
APP_SEED_APPLICANT2_COMPANY=Sample Winery LLC

# --- More accounts as a JSON array (see docs/user-accounts.md); prefer bcrypt hashes ---
APP_USERS=

# --- Demo-account picker on the login page (demos only; anyone can sign in) ---
APP_DEMO_LOGIN=false
APP_DEMO_LOGIN_ACCOUNTS=

# --- Optional cloud pipeline (both keys required) ---
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# --- OCR (blank = auto-detect) ---
TESSDATA_PREFIX=
TESSERACT_LIBRARY_PATH=

# --- Storage: filesystem (default) or database ---
APP_STORAGE_TYPE=filesystem
APP_STORAGE_DIR=./data/uploads

# --- Sizing ---
OCR_MAX_CONCURRENT=2
DB_POOL_SIZE=10
TOMCAT_MAX_THREADS=200
